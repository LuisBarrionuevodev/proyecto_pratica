# Entorno: development | staging | production
ENVIRONMENT=development

# Development (Flask / run.py). Nunca usar esta URI en pytest ni en cloud.
SQLALCHEMY_DATABASE_URI=mysql+pymysql://USER:PASS@localhost:3306/digitaliza_sandbox

# Railway inyecta DATABASE_URL; se normaliza a mysql+pymysql automáticamente.
# DATABASE_URL=mysql://USER:PASS@HOST:PORT/digitaliza_pilot

# Piloto cloud (nombre congelado):
# digitaliza_pilot

# JWT (obligatorio >= 32 chars en staging/production)
JWT_SECRET_KEY=dev-change-this-secret

# CORS (obligatorio en staging/production, coma-separado)
# CORS_ORIGINS=https://digitaliza.vercel.app,http://localhost:5173

# Base dedicada y descartable para pytest / integración. Obligatoria al correr tests backend.
# Debe ser distinta de SQLALCHEMY_DATABASE_URI y contener "test" en el nombre (ej. digitaliza_test).
TEST_DATABASE_URL=mysql+pymysql://USER:PASS@localhost:3306/digitaliza_test

# Geocoding forward (GEO-PERF.1.3 / GEO-GOOGLE.2).
# Valores: geoapify | google | nominatim | none
GEOCODER_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# Opcional: fallback tras fallo recuperable de Google (p.ej. geoapify).
# GEOCODER_FALLBACK_PROVIDER=geoapify

# Opcional: consulta Google en shadow sin cambiar persistencia Geoapify.
# GEOCODER_GOOGLE_SHADOW=true

# Correo: smtp (local) o mailjet (HTTPS en producción Railway).
# MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=digitalizaetl@gmail.com
SMTP_PASS=
SMTP_FROM=Digitaliza <digitalizaetl@gmail.com>

# Mailjet Send API v3.1 (cuando MAIL_PROVIDER=mailjet)
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=digitalizaetl@gmail.com
# MAILJET_FROM_NAME=Digitaliza

# Duración del access JWT (minutos). Sin esta variable el código usa 480 (8 h).
# La librería Flask-JWT-Extended, sin configurar, usa solo 15 minutos.
# JWT_ACCESS_TOKEN_MINUTES=480