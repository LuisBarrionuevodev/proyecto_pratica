# Copiar a .env.local para desarrollo. En staging/prod el CI debe definir VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:5000/
# QA performance: logs [perf] en consola del navegador (1 = activo)
# VITE_PERF_LOG=1
# Geocode search manual mapa: nominatim (default) | google (futuro, no habilitado)
# VITE_GEOCODE_SEARCH_PROVIDER=nominatim
